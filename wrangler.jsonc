{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evergarden",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  // Variables set in the dashboard survive deploys. Secrets always do.
  "keep_vars": true,
  // An instance answers on its own domain only: BETTER_AUTH_URL is the one address sign-in accepts.
  "workers_dev": false,
  "preview_urls": false,
  // A page makes several D1 queries in a row; running near the database makes each one cheap.
  "placement": { "mode": "smart" },
  // No resource ids: `wrangler deploy` creates the database on first deploy
  // and links them by name afterwards, so every instance gets its own.
  // Sends sign-in codes through Cloudflare Email Service; EMAIL_FROM names the sender.
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "evergarden", "migrations_dir": "migrations" },
  ],
  // Files attached to documents, stored once by their hash. The build creates the bucket when it
  // is missing (`files:bucket`): Wrangler's own provisioning fails for a binding new to a Worker.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "evergarden-files" }],
}
