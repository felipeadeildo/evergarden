{
  "name": "evergarden",
  "private": true,
  "description": "Publish what your agents write, and review it like a pull request.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy && bun run db:migrate:remote",
    "typegen": "wrangler types",
    "auth:schema": "auth generate --config src/server/auth.ts --adapter drizzle --dialect sqlite --output src/server/db/auth-schema.ts --yes && oxfmt src/server/db/auth-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "oxfmt --check && oxlint --deny-warnings && auth check schema --config src/server/auth.ts && vitest run --passWithNoTests",
    "prepare": "lefthook install",
    "auth:check": "auth check schema --config src/server/auth.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.25",
    "@better-auth/mcp": "^1.7.25",
    "@better-auth/oauth-provider": "^1.7.25",
    "@fontsource-variable/literata": "^5.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/highlight": "^1.2.12",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "fractional-indexing": "^4.0.0",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "hast-util-to-string": "^3.0.1",
    "hast-util-to-text": "^4.0.3",
    "jose": "^6.2.17",
    "katex": "^0.19.1",
    "mdast-util-to-string": "^4.0.0",
    "pele": "^1.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.1.18",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "auth": "^1.7.25",
    "drizzle-kit": "^0.31.11",
    "hast-util-to-html": "^9.0.6",
    "lefthook": "^2.2.2",
    "mdast-util-math": "^3.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "playwright": "1.65.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "packageManager": "bun@1.4.4",
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Signs sessions. Generate one with `openssl rand -base64 32`."
      },
      "OWNER_EMAIL": {
        "description": "The email you sign in with. That account becomes the **owner** of this instance; everyone else is a guest."
      },
      "GITHUB_CLIENT_ID": {
        "description": "From a [GitHub OAuth app](https://github.com/settings/developers). Callback URL: `https://<your-worker>/api/auth/callback/github`."
      },
      "GITHUB_CLIENT_SECRET": {
        "description": "The secret of the same GitHub OAuth app."
      },
      "GOOGLE_CLIENT_ID": {
        "description": "Optional. Lets guests sign in with Google. Leave empty to offer GitHub only."
      },
      "GOOGLE_CLIENT_SECRET": {
        "description": "Optional. The secret of the same Google OAuth client."
      },
      "BETTER_AUTH_URL": {
        "description": "Optional. The public URL, such as `https://evergarden.example.com`. Leave empty to use the URL of each request."
      }
    }
  }
}
