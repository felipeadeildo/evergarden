# Secrets, one per line. Locally, copy this file to .dev.vars.
# In production, set them under Settings > Variables and Secrets, or with `bunx wrangler secret put`.
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
OWNER_EMAIL=you@example.com
# The address sign-in codes come from, on a domain onboarded to Cloudflare Email Service.
# Locally nothing is sent: the code is printed in the terminal running `bun run dev`.
EMAIL_FROM=evergarden@example.com
# The public URL, without a trailing slash. Agents sign in over OAuth against it.
BETTER_AUTH_URL=http://localhost:3000
