# Secrets, one per line. Locally, copy this file to .dev.vars.
# In production, set them under Settings > Variables and Secrets, or with `bunx wrangler secret put`.
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
OWNER_EMAIL=you@example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: Google sign-in for guests.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the public URL. Without it, the URL is taken from each request.
BETTER_AUTH_URL=http://localhost:3000
